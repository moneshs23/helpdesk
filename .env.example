# ============================================================
#  AI Customer Support Assistant — Environment Configuration
#  Copy this file to `.env` and adjust as needed.
#  Everything runs LOCALLY. No cloud / Google / OpenAI keys.
# ============================================================

# ---- App ----
APP_NAME="AI Customer Support Assistant"
APP_ENV=development
DEBUG=true
HOST=0.0.0.0
BACKEND_PORT=8000
# Comma separated list of allowed CORS origins ("*" for all in dev)
CORS_ORIGINS=*

# ---- Ollama (Local LLM) ----
OLLAMA_BASE_URL=http://127.0.0.1:11434
# Default chat/generation model — Gemma 3 (4B)
LLM_MODEL=gemma3:4b
# Temperature / generation controls
LLM_TEMPERATURE=0.2
LLM_NUM_CTX=4096
LLM_NUM_PREDICT=768
LLM_KEEP_ALIVE=30m
# Extra LLM call to rewrite the query for retrieval (off = faster)
ENABLE_QUERY_REWRITE=false

# ---- Embeddings ----
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIM=768
EMBEDDING_BATCH_SIZE=16

# ---- Qdrant (Local Vector DB) ----
# Embedded local mode uses a path; server mode uses host/port.
QDRANT_MODE=local
QDRANT_PATH=./data/qdrant
QDRANT_HOST=127.0.0.1
QDRANT_PORT=6333
QDRANT_DOCS_COLLECTION=documents
QDRANT_CHATS_COLLECTION=conversations

# ---- SQLite Database ----
DATABASE_URL=sqlite+aiosqlite:///./data/sqlite/app.db

# ---- Translation ----
# Engine: "gemma" (light, uses Ollama) or "nllb" (transformers, heavier)
TRANSLATION_ENGINE=gemma
NLLB_MODEL=facebook/nllb-200-distilled-600M
NLLB_DEVICE=auto

# ---- RAG / Retrieval ----
CHUNK_SIZE=800
CHUNK_OVERLAP=120
TOP_K_DOCS=6
TOP_K_CHATS=4
# Minimum cosine similarity a chunk must reach to be considered relevant.
# Calibrated for nomic-embed-text (relevant ~0.75+, unrelated ~0.5).
MIN_SCORE_THRESHOLD=0.6
HYBRID_ALPHA=0.5

# ---- Neo4j (Optional Graph Retrieval) ----
# Enable for relationship-aware retrieval (product links, escalation paths, etc.)
# Requires a running Neo4j instance. Falls back to vector-only when disabled.
NEO4J_ENABLED=false
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=
# Weight for graph results when merging with vector results (0.0–1.0)
GRAPH_RETRIEVAL_WEIGHT=0.3

# ---- Uploads ----
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=25
ENABLE_OCR=false

# ---- Security ----
RATE_LIMIT_PER_MINUTE=60
LOG_LEVEL=INFO
